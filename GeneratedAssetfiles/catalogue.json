{
  "library_id": "generated_assets",
  "library_name": "Almond Generated Architectural Asset Library",
  "schema_version": "2.0",
  "purpose": "Redistributable 3D architectural entourage, building components, fixtures and unbranded furniture placeholders, generated with Meshy and normalised to real-world millimetre dimensions with authored Almond spatial contracts.",
  "generation_recipe": {
    "image_stage": {
      "tool": "meshy_text_to_image",
      "ai_model": "nano-banana",
      "aspect_ratio": "1:1",
      "prompt_suffix": " Single object, isolated on a plain white background, three-quarter view from slightly above, soft even studio lighting, no cast shadow, no text, realistic real-world proportions, clean architectural visualisation asset."
    },
    "mesh_stage": {
      "tool": "meshy_image_to_3d",
      "ai_model": "meshy-t2",
      "model_type": "smart-topology",
      "should_texture": false,
      "target_formats": [
        "glb"
      ],
      "auto_size": true,
      "origin_at": "bottom"
    },
    "post_process": "tools/build_generated_assets.py normalises each GLB: scales uniformly to the catalogue height, re-centres bottom-centre on the origin, renames every material to ALMOND::<render_material_id>, measures bounds, writes manifest.json and one .almond.json contract per asset.",
    "high_detail_override": {
      "applies_to": "assets with recipe_override = high_detail (trees)",
      "image_stage": {
        "tool": "meshy_text_to_image",
        "ai_model": "nano-banana-pro",
        "aspect_ratio": "1:1",
        "prompt_suffix": " Single tree, isolated on a plain white background, side view slightly from above, soft even studio lighting, no cast shadow, no ground, no text, realistic proportions."
      },
      "mesh_stage": {
        "tool": "meshy_image_to_3d",
        "ai_model": "meshy-7",
        "ultra_mode": true,
        "should_texture": false,
        "target_formats": [
          "glb"
        ],
        "target_polycount": 60000,
        "auto_size": true,
        "origin_at": "bottom"
      },
      "credits_per_asset": 34
    }
  },
