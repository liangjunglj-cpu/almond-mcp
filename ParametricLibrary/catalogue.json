      "id": "facade-attractor-perforation",
      "title": "Attractor perforated panel",
      "category": "facade",
      "level": "beginner",
      "summary": "A square panel is covered with a grid of circular perforations whose size grows with distance from an attractor point - the classic way to grade a perforated metal facade or screen from open to closed.",
      "definition": "definitions/facade-attractor-perforation.ghx",
      "lesson": "lessons/facade-attractor-perforation.lesson.json",
      "preview": "previews/facade-attractor-perforation.png",
      "steps": [
        "1  INPUTS - change these",
        "2  Panel and point grid",
        "3  Attractor field",
        "4  Perforations",
        "5  RESULT - colour by hole size"
      ],
